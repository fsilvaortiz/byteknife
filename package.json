{
  "name": "byteknife",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Utilidades para desarrolladores que corren 100 % en el navegador. Workspace: packages/core, packages/platform y apps/web.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @byteknife/web dev",
    "typecheck": "pnpm --filter './packages/*' --filter @byteknife/desktop typecheck",
    "build": "pnpm typecheck && pnpm --filter @byteknife/web build",
    "preview": "pnpm --filter @byteknife/web preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @byteknife/web e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm --filter @byteknife/web size",
    "lighthouse": "pnpm --filter @byteknife/web lighthouse",
    "tool-heights": "pnpm --filter @byteknife/web tool-heights",
    "desktop:dev": "pnpm --filter @byteknife/desktop tauri dev",
    "desktop:build": "CI=true pnpm --filter @byteknife/desktop tauri build --target universal-apple-darwin",
    "desktop:e2e": "pnpm --filter @byteknife/desktop e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
