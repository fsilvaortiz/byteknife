{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteKnife",
  "version": "../package.json",
  "identifier": "dev.byteknife.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ByteKnife",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Utilidades para desarrolladores que corren en tu Mac",
    "copyright": "© 2026 Fabián Silva Ortiz · MIT",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMDNERDAxN0ZDQTYxNzUKUldSMVljcC9BZDBEYXNUK2FEUGxXZ0xOcHVPZ24vVWFncWt0NWpjY2dNOXdYdDhha0ZJMkcyZU0K",
      "endpoints": ["https://github.com/fsilvaortiz/byteknife/releases/latest/download/latest.json"]
    }
  }
}
