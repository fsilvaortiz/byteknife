---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/app.css';
import CommandPalette from '../components/CommandPalette';
import SearchButton from '../components/SearchButton';
import Toast from '../ui/Toast';
import { homePath } from '../core/paths';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="logo" href={homePath(locale)} aria-label={t(locale, 'logo.aria')}>
          byteknife<span class="cur" aria-hidden="true"></span>
        </a>
        <SearchButton client:load locale={locale} />
      </div>
    </header>
    <main id="app">
      <slot />
    </main>
    <CommandPalette client:load locale={locale} />
    <Toast client:idle />
  </body>
</html>
