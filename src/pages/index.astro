---
import '../styles/tokens.css';
import '../styles/base.css';
import { homePath } from '../core/paths';
import { alternates } from '../core/seo';
import { locales, t } from '../i18n';

// Raíz: redirige al idioma guardado o al del navegador (src/core/locale.ts). Sin JS,
// muestra los tres enlaces.
const alts = alternates(Astro.site!.href, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ByteKnife</title>
    <meta name="description" content={t('en', 'site.tagline')} />
    <link rel="canonical" href={alts.at(-1)!.href} />
    {alts.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <main class="root">
      <h1>ByteKnife</h1>
      <ul>
        {locales.map((l) => (
          <li lang={l}>
            <a href={homePath(l)} hreflang={l} data-locale-link={l}>
              {t(l, 'lang.name')}
            </a>
            <span>{t(l, 'site.tagline')}</span>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>

<script>
  import { pickLocale } from '../core/locale';
  import { homePath } from '../core/paths';
  import { local, read, write } from '../core/storage';
  import { registerServiceWorker } from '../core/sw-register';
  import { countVisit } from '../core/visit';

  document.querySelectorAll<HTMLElement>('[data-locale-link]').forEach((a) => {
    a.addEventListener('click', () => write(local, 'locale', a.dataset.localeLink));
  });
  registerServiceWorker();
  // Se cuenta aquí: después de redirigir, el origen externo (HN, Reddit…) ya no se ve.
  countVisit();
  window.location.replace(homePath(pickLocale(read(local, 'locale', null), navigator.languages)));
</script>

<style>
  .root {
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 16px;
  }
  h1 {
    font: 800 32px/1 var(--f-display);
    letter-spacing: -0.03em;
    margin: 0 0 24px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  li {
    display: grid;
    gap: 2px;
  }
  a {
    font-weight: 600;
  }
  span {
    color: var(--muted);
  }
</style>
