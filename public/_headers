# Cabeceras de Cloudflare (Workers Static Assets). La CSP con los hashes de cada página va
# en un <meta> que genera Astro (astro.config.mjs); aquí van las directivas que un <meta>
# no puede declarar y el resto de las cabeceras de seguridad.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Nombres con hash: nunca cambian.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker debe revisarse en cada visita para que las versiones nuevas lleguen.
/sw.js
  Cache-Control: no-cache
