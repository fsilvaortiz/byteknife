// Despliegue en Cloudflare Workers: sirve apps/web/dist/ como sitio estático. Solo /api/* pasa por el
// Worker (apps/web/worker/index.ts), que cuenta visitas en Workers Analytics Engine.
{
  "name": "byteknife",
  "compatibility_date": "2026-10-01",
  "main": "apps/web/worker/index.ts",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "byteknife_visits" }],
  // Vistas previas por rama (`wrangler preview`): sin el binding VISITS, para que no cuenten.
  "previews": {},
}
